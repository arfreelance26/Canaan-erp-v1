# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# backend application logs (keep the folder, ignore the log files)
backend/logs/*.log
backend/logs/*.log.*

# env files — keep .env.example in git, ignore everything else
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
frontend/node_modules/
frontend/.next/
backend/__pycache__/
backend/**/*.pyc
.claude/
frontend/out/
frontend/out.zip

# stray local databases (app uses MySQL) & python caches
*.db
*.sqlite
*.sqlite3
backend/__pycache__/
**/__pycache__/

# local tooling caches
.claude/
.tokensave/

# agent/instruction files — kept local, not published
AGENTS.md
CLAUDE.md

# editor settings
.vscode/
.idea/

# desktop (Electron) — not part of the web app
desktop/

# sensitive environment files (never commit real credentials)
backend/.env
frontend/.env.local

# client data files (sensitive Excel imports)
data/

# built installers & release artifacts
desktop/release/
desktop/build/

# zip archives
*.zip
