DB_USER=root
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_NAME=canaan

# Or set the full URL directly (overrides the above)
# DATABASE_URL=mysql+pymysql://root:password@localhost/canaan

# --- Security (REQUIRED in production) ---------------------------------------
# JWT signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Built-in administrator account
ADMIN_USERNAME=admin@canaan.com
ADMIN_PASSWORD=change_this_strong_password

# How long a login session lasts (hours)
ACCESS_TOKEN_EXPIRE_HOURS=12

# Comma-separated list of allowed frontend origins. "*" allows all (dev only).
# e.g. CORS_ORIGINS=https://erp.canaanglobal.com
CORS_ORIGINS=*
