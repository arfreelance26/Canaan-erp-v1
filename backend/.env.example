# ---------------------------------------------------------------------------
# Canaan ERP — backend environment template.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Deployment environment. Set to "production" on live servers — this makes the
# app FAIL TO START if SECRET_KEY or ADMIN_PASSWORD are missing/weak (fail-closed).
APP_ENV=development

# --- Database ---
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_NAME=canaan

# --- Auth / JWT ---
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Must be >= 32 chars. Rotating this invalidates all existing sessions.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_HOURS=12

# Built-in admin account. In production ADMIN_PASSWORD MUST be set to a strong
# value (>= 10 chars) or the app refuses to start. Rotate on staff offboarding.
ADMIN_USERNAME=admin@canaan.com
ADMIN_PASSWORD=

# Password policy (staff/driver password minimum length).
MIN_PASSWORD_LENGTH=10

# --- CORS ---
# Comma-separated allowed frontend origins. Use "*" only in development.
# Production example: https://erp.canaanglobalinternational.com
CORS_ORIGINS=*

# --- Transport security ---
# Set to 1 ONLY when HTTPS is terminated end-to-end (adds HSTS header).
ENABLE_HSTS=0


# --- Canaan Chat message encryption (AES-256-GCM) ---------------------------
# REQUIRED in production — the backend refuses to start without it when
# APP_ENV=production. 32 random bytes, base64:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Message bodies are unreadable without this key, so back it up alongside the
# database. To rotate, use CHAT_ENCRYPTION_KEYS="1:<old>,2:<new>" plus
# CHAT_ENCRYPTION_KEY_ID=2 and keep the old key as long as old rows exist.
CHAT_ENCRYPTION_KEY=
