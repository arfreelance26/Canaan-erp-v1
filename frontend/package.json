{
  "name": "canaan-erp",
  "version": "1.0.0",
  "private": true,
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "NODE_ENV=development npm run electron:compile && electron .",
    "electron:build": "next build && npm run electron:compile && electron-builder",
    "electron:preview": "npm run electron:compile && electron ."
  },
  "build": {
    "appId": "com.canaanglobal.erp",
    "productName": "Canaan ERP",
    "copyright": "Copyright © 2025 Canaan Global International",
    "icon": "build-resources/icon.png",
    "files": [
      "electron-dist/**/*",
      "out/**/*",
      "public/**/*"
    ],
    "directories": {
      "buildResources": "build-resources",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.12",
    "page-agent": "^1.12.2",
    "react": "19.2.4",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.4",
    "react-haiku": "^2.4.1",
    "recharts": "^3.8.1",
    "sweetalert2": "^11.26.25",
    "sweetalert2-react-content": "^5.1.2",
    "tailwind-merge": "^3.6.0",
    "ts-morph": "^28.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "unrs-resolver@1.12.2": true,
    "electron-winstaller@5.4.0": true,
    "core-js@3.49.0": true,
    "sharp@0.35.3": true
  }
}
